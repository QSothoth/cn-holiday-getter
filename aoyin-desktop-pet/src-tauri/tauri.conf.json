{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "敖尹桌宠",
  "version": "0.2.0",
  "identifier": "com.qsothoth.aoyin.desktop-pet",
  "build": { "frontendDist": "../app" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "敖尹桌宠",
        "width": 520,
        "height": 700,
        "minWidth": 320,
        "minHeight": 430,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: data: blob:; img-src 'self' asset: data: blob:; script-src 'self' 'unsafe-inline' asset:; style-src 'self' 'unsafe-inline'; connect-src 'self' asset: data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Entertainment",
    "shortDescription": "A fan-made Ao Yin Live2D desktop companion",
    "longDescription": "A transparent cross-platform Live2D desktop companion with gaze tracking and a removable-glasses action.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "wix": { "language": ["zh-CN", "en-US"] },
      "nsis": { "installerIcon": "icons/icon.ico" }
    },
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
